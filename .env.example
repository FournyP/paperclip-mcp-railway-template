# Gateway service ----------------------------------------------------------
# Required. Comma-separated list of allowed bearer tokens. Clients must send:
#   Authorization: Bearer <one of these keys>
# Allowed characters per key: A-Z a-z 0-9 . _ ~ + / = -
API_KEYS=

# Optional. Defaults match the template's internal wiring; only override if
# you rename the mcp service.
# MCP_HOST=paperclip-mcp.railway.internal
# MCP_PORT=8000

# Optional. Port nginx listens on. Railway injects PORT.
# PORT=80

# Optional. `true` also accepts the key as a path segment: /k/<key>/mcp
# MCP clients that cannot send an Authorization header need this.
# PATH_KEY_AUTH=false

# MCP service --------------------------------------------------------------
# Required. Base URL of your Paperclip instance; "/api" is appended when
# missing. On Railway, use the private network:
#   http://<paperclip-service>.railway.internal:<port>
PAPERCLIP_API_URL=

# Required in practice. A BOARD API key (pcp_board_...) unlocks every tool:
# approve/reject, pause/resume agents, budgets, attention feed, decisions.
# An AGENT API key is scoped to that agent and board-only tools return 403.
# Mint a board key with `paperclipai login` or POST /api/board-api-keys.
# Empty is accepted only by a local_trusted Paperclip deployment.
PAPERCLIP_API_KEY=

# Required. Company UUID every company-scoped tool operates on. It is the
# UUID in the Paperclip UI URL: /companies/<uuid>
PAPERCLIP_COMPANY_ID=

# Optional. Default agent UUID for checkout_issue when using a board key.
# PAPERCLIP_AGENT_ID=

# Optional. Forwarded as X-Paperclip-Run-Id on writes. Only ever a REAL
# heartbeat run id — a made-up UUID breaks a foreign key server-side.
# PAPERCLIP_RUN_ID=

# Optional. Port the MCP server listens on. Pinned to 8000 by the IaC file so
# the gateway's MCP_PORT cannot drift from it.
# PORT=8000
